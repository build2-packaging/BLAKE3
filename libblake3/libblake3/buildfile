# Select the SIMD implementations that blake3_dispatch.c expects to be
# linked with on the target CPU (see c/README.md in upstream for
# background).
#
# On x86_64 we use the assembly implementations that upstream recommends
# for their speed. They come in the GNU and MASM flavors and we can only
# compile the GNU one, so MSVC gets the C intrinsics implementations, as
# does 32-bit x86. On little-endian AArch64 blake3_impl.h enables NEON by
# default. Every other CPU uses the portable implementation, which we
# build everywhere.
#
asm        = false
intrinsics = false

switch $c.target.cpu: regex.match
{
  case 'x86_64'
  {
    asm        = ($c.class == 'gcc')
    intrinsics = (!$asm)
  }
  case 'i[3-6]86'
    intrinsics = true
}

neon = ($c.target.cpu == 'aarch64')

simd = blake3_sse2 blake3_sse41 blake3_avx2 blake3_avx512

lib{blake3}: {h c}{** -{$simd} -blake3_neon}
lib{blake3}: S{*_unix}:        include = ($asm && $c.target.class != 'windows')
lib{blake3}: S{*_windows_gnu}: include = ($asm && $c.target.class == 'windows')
lib{blake3}: c{$simd}:         include = $intrinsics
lib{blake3}: c{blake3_neon}:   include = $neon

# Build options.
#
src_pfx = [dir_path] $src_root/libblake3/

c.poptions =+ "-I$src_pfx"

# Give the internal C functions hidden visibility, the same as upstream.
# The public functions are visible through BLAKE3_API, which on Windows
# marks them for DLL export.
#
if ($c.class == 'gcc' && $c.target.class != 'windows')
  c.coptions += -fvisibility=hidden

objs{*}: c.poptions += -DBLAKE3_DLL -DBLAKE3_DLL_EXPORTS

# Enable each intrinsics implementation's instruction set for its own
# translation unit. The target's baseline stays the same since each of
# these translation units holds the implementation for one instruction set
# and blake3_dispatch.c calls it only after detecting CPU support at
# runtime.
#
# GCC and every Clang variant, clang-cl included, require the instruction
# set to be enabled to compile its intrinsics. MSVC enables SSE2 and SSE4.1
# by default and only needs the options for AVX2 and AVX-512.
#
if $intrinsics
{
  if ($c.class == 'gcc' || $c.id == 'msvc-clang')
  {
    {obja objs}{blake3_sse2}:   c.coptions += -msse2
    {obja objs}{blake3_sse41}:  c.coptions += -msse4.1
    {obja objs}{blake3_avx2}:   c.coptions += -mavx2
    {obja objs}{blake3_avx512}: c.coptions += -mavx512f -mavx512vl
  }
  else
  {
    {obja objs}{blake3_avx2}:   c.coptions += /arch:AVX2
    {obja objs}{blake3_avx512}: c.coptions += /arch:AVX512
  }
}

# Export options.
#
lib{blake3}: c.export.poptions = "-I$src_pfx"

libs{blake3}: c.export.poptions += -DBLAKE3_DLL

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{blake3}: bin.lib.version = "-$version.project_id"
else
  lib{blake3}: bin.lib.version = "-$version.major.$version.minor"

# Only install the public header and directly into, say, /usr/include/,
# the same as upstream.
#
h{blake3}@./: install = include/
h{*}: install = false
